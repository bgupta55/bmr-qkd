{
  "experiment": "E7b",
  "description": "BMR vs SR-Dijkstra (Pirandola et al.) comparison (Reviewer 2 Comment 5)",
  "implementation_notes": {
    "SR_Dijkstra": "Modified Dijkstra maximising min-bottleneck r_e subject to \u03a3w_e \u2264 \u0394. Uses Pareto (rate, budget) labels per node. Deviation: wavelength/time-slot assignment dropped (out of scope for trusted-relay QKD). Implemented from Pirandola et al. PRL Research 8(3) 033221 (2026) \u00a7III description.",
    "BMR": "Binary search on bottleneck rate + Yen's k-shortest simple paths with hop floor K=2t+1. Same certificate database and random draws as all baselines.",
    "Rate_Greedy": "Max-min rate, no Bell evidence, no expiry, no budget.",
    "SPF": "Hop-count Dijkstra."
  },
